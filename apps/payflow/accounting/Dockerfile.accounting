# ---------- Base image ----------
FROM node:20-alpine

Acknowledgement: Use a small, secure Node.js image suitable for production.

# ---------- Set working directory ----------
WORKDIR /app

# ---------- Copy package files ----------
COPY package*.json ./

# ---------- Install dependencies ----------
RUN npm install --only=production

# ---------- Copy source code ----------
COPY . .

# ---------- Build TypeScript ----------
RUN npm run build

# ---------- Expose port ----------
EXPOSE 4001

# ---------- Start application ----------
CMD ["node", "dist/server.js"]